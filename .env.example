NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
# Requires pino-pretty (devDependency). Keep false in Docker/production images.
LOG_PRETTY=false

# Shared Redis 7 (Compose service hostname inside the network)
REDIS_URL=redis://redis:6379

# Must match Laravel WS_TICKET_REDIS_PREFIX exactly (no Laravel REDIS_PREFIX on ticket keys)
WS_TICKET_REDIS_PREFIX=battle-arena:ws-ticket:
WS_TICKET_TTL_SECONDS=30

# Browser Origin allowlist (comma-separated). Native clients may omit Origin.
WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WS_ALLOW_MISSING_ORIGIN=true

WS_PATH=/ws
WS_HEARTBEAT_INTERVAL_MS=30000
WS_HEARTBEAT_TIMEOUT_MS=60000
WS_MAX_PAYLOAD_BYTES=8192
WS_MAX_CONNECTIONS=1000
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_CONNECTIONS_PER_IP=20
WS_MAX_CONNECTION_LIFETIME_MS=3600000
WS_MAX_BUFFERED_BYTES=65536
SHUTDOWN_TIMEOUT_MS=10000
