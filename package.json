{
  "name": "battle-arena-realtime",
  "version": "0.1.0",
  "private": true,
  "description": "Battle Arena Phase 5A authenticated WebSocket gateway (transport only)",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "pino": "^9.6.0",
    "redis": "^4.7.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "3.1161.0",
    "@aws-sdk/client-lambda": "3.1161.0",
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "eslint": "^9.22.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
